<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- OpenCode commonly runs over HTTP, including on user-managed private networks. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
